{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "ask": ["Bash(git commit)", "Bash(git commit *)", "Bash(git push *)", "Bash(git config *)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)", "Read(./credentials/**)"]
  }
}
